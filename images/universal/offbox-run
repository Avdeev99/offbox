#!/bin/sh
set -eu
umask 077

fail() {
    printf 'offbox-run: %s\n  Fix: %s\n' "$1" "$2" >&2
    exit 2
}

validate_id() {
    case "$1" in ''|*[!A-Za-z0-9_-]*) fail 'Invalid run ID.' 'Use a unique alphanumeric run ID without path separators.' ;; esac
    [ "${#1}" -le 64 ] || fail 'Run ID is too long.' 'Use at most 64 characters.'
}

process_info() {
    if [ -r "/proc/$1/stat" ]; then
        sed 's/^.*) //' "/proc/$1/stat" 2>/dev/null | awk '{print $3, $20}'
    fi
}

state_dir=/run/offbox/exec
cgroup_root=/sys/fs/cgroup/offbox
sudo=
[ "$(id -u)" = 0 ] || sudo='sudo -n'

cgroup_occupied() {
    grep -q . "$cgroup_root/$1/cgroup.procs" 2>/dev/null
}

cgroup_wait_empty() {
    tries=$2
    while [ "$tries" -gt 0 ]; do
        cgroup_occupied "$1" || return 0
        sleep 0.1
        tries=$((tries - 1))
    done
    ! cgroup_occupied "$1"
}

cgroup_kill() {
    [ ! -f "$cgroup_root/$1/cgroup.kill" ] || printf '1\n' > "$cgroup_root/$1/cgroup.kill" 2>/dev/null || :
}

cgroup_stop() {
    [ -d "$cgroup_root/$1" ] || return 0
    while IFS= read -r member; do
        [ "$(process_info "$member" | awk '{print $1}')" != "$2" ] || continue
        /bin/kill -TERM "$member" 2>/dev/null || :
    done < "$cgroup_root/$1/cgroup.procs"
    if ! cgroup_wait_empty "$1" 30; then
        cgroup_kill "$1"
        cgroup_wait_empty "$1" 10 || :
    fi
    rmdir "$cgroup_root/$1" 2>/dev/null || :
}

if [ "${1:-}" = --cgroup ]; then
    [ "$(id -u)" = 0 ] || fail 'Run cgroups are managed as root.' 'Let offbox-run call this mode through sudo.'
    umask 022
    action=${2:-}
    if [ "$action" = prune ]; then
        for run_cgroup in "$cgroup_root"/*; do
            [ -d "$run_cgroup" ] || continue
            # A cgroup without a record may belong to a run that is still starting; only an older one is orphaned.
            if [ -e "$state_dir/${run_cgroup##*/}.code" ] || { [ ! -e "$state_dir/${run_cgroup##*/}.pid" ] && [ -n "$(find "$run_cgroup" -maxdepth 0 -mmin +1)" ]; }; then
                rmdir "$run_cgroup" 2>/dev/null || :
            fi
        done
        exit 0
    fi
    validate_id "${3:-}"
    case "$action" in
        join)
            case "${4:-}" in ''|*[!0-9]*) fail 'Invalid process ID.' 'Pass the PID of the run command.' ;; esac
            [ "$4" -gt 1 ] || fail 'Unsafe process ID.' 'Pass the PID of the run command.'
            [ -f /sys/fs/cgroup/cgroup.controllers ] || exit 0
            mkdir -p "$cgroup_root/$3"
            if [ ! -f "$cgroup_root/$3/cgroup.kill" ]; then
                rmdir "$cgroup_root/$3" 2>/dev/null || :
                exit 0
            fi
            printf '%s\n' "$4" > "$cgroup_root/$3/cgroup.procs" 2>/dev/null || {
                mkdir -p "$cgroup_root/$3"
                printf '%s\n' "$4" > "$cgroup_root/$3/cgroup.procs"
            }
            ;;
        release) rmdir "$cgroup_root/$3" 2>/dev/null || : ;;
        stop) cgroup_stop "$3" "${4:-}" ;;
        *) fail 'Unknown cgroup action.' 'Use join, release, stop or prune.' ;;
    esac
    exit 0
fi

mkdir -p "$state_dir"
if [ "${1:-}" = --signal ]; then
    [ "$#" -eq 3 ] || fail 'Expected --signal SIGNAL ID.' 'Pass INT, TERM or KILL and the recorded run ID.'
    signal=$2
    run_id=$3
    case "$signal" in INT|TERM|KILL) ;; *) fail 'Unsupported signal.' 'Use INT, TERM or KILL.' ;; esac
    validate_id "$run_id"
    [ ! -f "$state_dir/$run_id.code" ] || exit 0
    [ ! -f "$state_dir/$run_id.tty" ] || fail 'External group signaling is unavailable for TTY runs.' 'Use terminal controls for a TTY command.'
    if [ ! -f "$state_dir/$run_id.pid" ] || [ ! -f "$state_dir/$run_id.start" ]; then
        fail 'Run metadata is unavailable.' 'Check the run status before retrying.'
    fi
    pid=$(cat "$state_dir/$run_id.pid")
    started=$(cat "$state_dir/$run_id.start")
    case "$pid:$started" in *[!0-9:]*|:*|*:) fail 'Invalid process metadata.' 'Check the run status before retrying.' ;; esac
    [ "$pid" -gt 1 ] || fail 'Unsafe process group.' 'Check the run status before retrying.'
    actual=$(process_info "$pid")
    [ "$actual" = "$pid $started" ] || fail 'Run process group no longer matches its recorded identity.' 'Check the run status; do not signal a reused PID.'
    # The marker makes the run stop its whole cgroup once the group exits; mkdir never follows a planted link.
    mkdir "$state_dir/$run_id.stopped" 2>/dev/null || :
    /bin/kill -"$signal" -- "-$pid"
    [ "$signal" != KILL ] || cgroup_kill "$run_id"
    exit 0
fi

tty=0
if [ "${1:-}" = --tty ]; then
    tty=1
    shift
fi
[ "$#" -ge 4 ] || fail 'Expected ID CWD -- COMMAND.' 'Pass the run ID, absolute work directory and command argv.'
run_id=$1
directory=$2
shift 2
[ "$1" = -- ] || fail 'Missing command separator.' 'Put -- before the command argv.'
shift
validate_id "$run_id"
case "$directory" in /*) ;; *) fail 'Work directory must be absolute.' 'Use the mapped /work directory.' ;; esac
if [ -e "$state_dir/$run_id.pid" ] || [ -e "$state_dir/$run_id.code" ]; then
    fail 'Run ID already exists.' 'Use a new run ID.'
fi
find "$state_dir" -maxdepth 1 -type f -mmin +1440 -print | while IFS= read -r expired; do
    expired_name=${expired##*/}
    case "$expired_name" in
        *.code.tmp) expired_id=${expired_name%.code.tmp} ;;
        *.code|*.pid|*.start|*.tty) expired_id=${expired_name%.*} ;;
        *) continue ;;
    esac
    case "$expired_id" in ''|*[!A-Za-z0-9_-]*) continue ;; esac
    if [ -f "$state_dir/$expired_id.code" ] && [ "$expired_name" != "$expired_id.code" ]; then
        continue
    fi
    expired_pid=$(cat "$state_dir/$expired_id.pid" 2>/dev/null || :)
    expired_start=$(cat "$state_dir/$expired_id.start" 2>/dev/null || :)
    case "$expired_pid:$expired_start" in
        *[!0-9:]*|:*|*:) ;;
        *)
            expired_identity=$(process_info "$expired_pid")
            if [ ! -f "$state_dir/$expired_id.code" ] && [ -n "$expired_identity" ] && [ "${expired_identity##* }" = "$expired_start" ]; then
                continue
            fi
            ;;
    esac
    rm -f "$state_dir/$expired_id.code" "$state_dir/$expired_id.pid" "$state_dir/$expired_id.start" "$state_dir/$expired_id.tty" "$state_dir/$expired_id.code.tmp"
    rmdir "$state_dir/$expired_id.stopped" 2>/dev/null || :
done
if find "$cgroup_root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | grep -q .; then
    $sudo /usr/local/bin/offbox-run --cgroup prune </dev/null >/dev/null 2>&1 || :
fi
cd "$directory" || fail 'Cannot enter the work directory.' 'Flush sync and check that the remote directory exists.'
child_pid=
pending_signal=
forward_signal() {
    pending_signal=$1
    if [ -n "$child_pid" ]; then
        if [ "$tty" = 1 ]; then
            [ "$1" != INT ] || return 0
            /bin/kill -s "$1" "$child_pid" 2>/dev/null || :
        else
            /bin/kill -"$1" -- "-$child_pid" 2>/dev/null || /bin/kill -s "$1" "$child_pid" 2>/dev/null || :
        fi
    fi
}
trap 'forward_signal INT' INT
trap 'forward_signal TERM' TERM
trap 'forward_signal HUP' HUP
exec 3<&0
if [ "$tty" = 1 ]; then
    touch "$state_dir/$run_id.tty"
fi
umask 022
if [ "$tty" = 1 ]; then
    env --default-signal=INT,TERM,HUP -- "$@" <&3 3<&- &
else
    # The command joins its own cgroup before it executes, so a stop reaches every descendant, even one that ran setsid.
    # shellcheck disable=SC2016 # expanded by the child shell, which receives sudo, the run ID and the argv
    setsid env --default-signal=INT,TERM,HUP sh -c '$1 /usr/local/bin/offbox-run --cgroup join "$2" "$$" </dev/null >/dev/null 2>&1 || :; shift 2; exec "$@"' \
        offbox-run "$sudo" "$run_id" "$@" <&3 3<&- &
fi
child_pid=$!
umask 077
exec 3<&-
identity=$(process_info "$child_pid")
printf '%s\n' "${identity##* }" > "$state_dir/$run_id.start"
printf '%s\n' "$child_pid" > "$state_dir/$run_id.pid"
if [ -n "$pending_signal" ]; then
    forward_signal "$pending_signal"
fi
while :; do
    if wait "$child_pid"; then
        status=0
    else
        status=$?
    fi
    kill -0 "$child_pid" 2>/dev/null || break
done
leader=$child_pid
child_pid=
if [ "$tty" = 0 ]; then
    if [ -d "$state_dir/$run_id.stopped" ]; then
        $sudo /usr/local/bin/offbox-run --cgroup stop "$run_id" "$leader" </dev/null >/dev/null 2>&1 || :
    else
        $sudo /usr/local/bin/offbox-run --cgroup release "$run_id" </dev/null >/dev/null 2>&1 || :
    fi
    rmdir "$state_dir/$run_id.stopped" 2>/dev/null || :
fi
printf '%s\n' "$status" > "$state_dir/$run_id.code.tmp"
mv "$state_dir/$run_id.code.tmp" "$state_dir/$run_id.code"
exit "$status"
